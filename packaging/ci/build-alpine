#!/bin/sh

set -eu

: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${TARGET_ARCHITECTURE:?TARGET_ARCHITECTURE is required}"
: "${SOURCE_DIR:?SOURCE_DIR is required}"
: "${PACKAGING_DIR:?PACKAGING_DIR is required}"
: "${ARTIFACT_DIR:?ARTIFACT_DIR is required}"

# shellcheck disable=SC1091
. /etc/os-release
case "$VERSION_ID" in
	3.24|3.24.*) ;;
	*)
		echo "Alpine 3.24 is required (found $VERSION_ID)" >&2
		exit 1
		;;
esac
case "$TARGET_ARCHITECTURE" in
	x86_64|aarch64) ;;
	*)
		echo "unsupported target architecture: $TARGET_ARCHITECTURE" >&2
		exit 1
		;;
esac
test "$(apk --print-arch)" = "$TARGET_ARCHITECTURE"
test "$(uname -m)" = "$TARGET_ARCHITECTURE"

apk add --no-cache \
	alpine-sdk \
	diffutils \
	git \
	jq \
	perl

git config --global --add safe.directory "$SOURCE_DIR"
git -C "$SOURCE_DIR" rev-parse --verify "$RELEASE_TAG^{commit}" >/dev/null
case "$RELEASE_TAG" in
	v?*) version=${RELEASE_TAG#v} ;;
	*)
		echo "release tag must start with v: $RELEASE_TAG" >&2
		exit 1
		;;
esac

apkbuild=$PACKAGING_DIR/packaging/alpine/APKBUILD
package_name=$(sed -n 's/^pkgname=//p' "$apkbuild")
package_version=$(sed -n 's/^pkgver=//p' "$apkbuild")
package_release=$(sed -n 's/^pkgrel=//p' "$apkbuild")
test "$package_name" = krb5keytab
test "$version" = "$package_version"
apk version --check "$package_version-r$package_release" >/dev/null

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
build_dir=$work/package
repository_dir=$work/packages
mkdir -p "$build_dir" "$repository_dir" "$ARTIFACT_DIR"
git -C "$SOURCE_DIR" archive --prefix="krb5_keytab-$version/" \
	"$RELEASE_TAG" | gzip -n >"$build_dir/krb5_keytab-$version.tar.gz"
cp "$apkbuild" "$build_dir/APKBUILD"

if test -n "${PACKAGER_PRIVKEY:-}"; then
	test -f "$PACKAGER_PRIVKEY"
else
	abuild-keygen -a -n
	cp /root/.abuild/*.rsa.pub /etc/apk/keys/
fi

# The ChapelTech dependency is runtime-only and may not be published yet.
# Build and test against the explicitly installed build dependencies.
(cd "$build_dir" && abuild -F -d -r -P "$repository_dir")

set -- "$repository_dir"/*/"$TARGET_ARCHITECTURE"/*.apk
test "$#" -eq 2
for package do
	test -f "$package"
	case "${package##*/}" in
		"$package_name-$package_version-r$package_release.apk") ;;
		"$package_name-doc-$package_version-r$package_release.apk") ;;
		*)
			echo "unexpected package output: $package" >&2
			exit 1
			;;
	esac
	apk verify "$package"
done

package_index=$work/APKINDEX.adb
apk mkndx --output "$package_index" "$@" >/dev/null
apk adbdump --format json "$package_index" | jq -e \
	--arg name "$package_name" \
	--arg version "$package_version-r$package_release" \
	--arg arch "$TARGET_ARCHITECTURE" '
	.packages as $packages |
	($packages | length) == 2 and
	any($packages[];
		.name == $name and .version == $version and .arch == $arch and
		(.depends | index("libkrb5admin-perl>=0.4.3")) != null and
		(.depends | index("perl")) != null) and
	any($packages[];
		.name == ($name + "-doc") and .version == $version and
		.arch == "noarch")
' >/dev/null

for package do
	cp "$package" "$ARTIFACT_DIR/"
done
