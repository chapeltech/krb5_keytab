#!/bin/sh

set -eu

: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${TARGET_ARCHITECTURE:?TARGET_ARCHITECTURE is required}"
: "${SOURCE_DIR:?SOURCE_DIR is required}"
: "${PACKAGING_DIR:?PACKAGING_DIR is required}"
: "${ARTIFACT_DIR:?ARTIFACT_DIR is required}"

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install --no-install-recommends -y \
    build-essential \
    debhelper \
    dpkg-dev \
    perl

test "$(dpkg --print-architecture)" = "$TARGET_ARCHITECTURE"
git config --global --add safe.directory "$SOURCE_DIR"
git -C "$SOURCE_DIR" rev-parse --verify "$RELEASE_TAG^{commit}" >/dev/null
version=$(cd "$PACKAGING_DIR" && dpkg-parsechangelog -SVersion)
test "${RELEASE_TAG#v}" = "${version%%-*}"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
mkdir -p "$work/source" "$ARTIFACT_DIR"
git -C "$SOURCE_DIR" archive "$RELEASE_TAG" | tar -x -C "$work/source"
rm -rf "$work/source/debian"
cp -a "$PACKAGING_DIR/debian" "$work/source/"

(
	cd "$work/source"
	DEB_BUILD_OPTIONS="parallel=$(nproc)" \
	    dpkg-buildpackage --build=binary --no-sign
)

for package in "$work"/*.deb; do
	test -f "$package"
	test "$(dpkg-deb -f "$package" Architecture)" = \
	    "$TARGET_ARCHITECTURE"
	cp "$package" "$ARTIFACT_DIR/"
done
