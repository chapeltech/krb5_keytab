#!/bin/sh

set -eu

: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${TARGET_ARCHITECTURE:?TARGET_ARCHITECTURE is required}"
: "${SOURCE_DIR:?SOURCE_DIR is required}"
: "${PACKAGING_DIR:?PACKAGING_DIR is required}"
: "${ARTIFACT_DIR:?ARTIFACT_DIR is required}"

dnf install -y \
    diffutils \
    file \
    findutils \
    gcc \
    gzip \
    make \
    perl \
	perl-generators \
	rpm-build \
	tar

# shellcheck disable=SC1091
. /etc/os-release
test "${VERSION_ID%%.*}" = 9
test "$TARGET_ARCHITECTURE" = x86_64
test "$(uname -m)" = "$TARGET_ARCHITECTURE"
git config --global --add safe.directory "$SOURCE_DIR"
git -C "$SOURCE_DIR" rev-parse --verify "$RELEASE_TAG^{commit}" >/dev/null
spec=$PACKAGING_DIR/packaging/rpm/krb5keytab.spec
version=$(rpm --specfile -q --qf '%{VERSION}\n' "$spec" | head -1)
test "${RELEASE_TAG#v}" = "$version"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
topdir=$work/rpmbuild
mkdir -p "$topdir/SOURCES" "$ARTIFACT_DIR"
git -C "$SOURCE_DIR" archive --prefix="krb5_keytab-$version/" \
    "$RELEASE_TAG" | gzip -n >"$topdir/SOURCES/krb5_keytab-$version.tar.gz"
rpmbuild --define "_topdir $topdir" -ba "$spec"

for package in "$topdir"/RPMS/*/*.rpm; do
	test -f "$package"
	test "$(rpm -qp --qf '%{ARCH}' "$package")" = "$TARGET_ARCHITECTURE"
	cp "$package" "$ARTIFACT_DIR/"
done
for package in "$topdir"/SRPMS/*.src.rpm; do
	test -f "$package"
	cp "$package" "$ARTIFACT_DIR/"
done
