#!/bin/sh

set -eu
umask 077

if [ "$#" -eq 0 ]; then
	echo "usage: $0 package.rpm [...]" >&2
	exit 2
fi

: "${RPM_SIGNING_KEY:?RPM_SIGNING_KEY is required}"
: "${RPM_SIGNING_FINGERPRINT:?RPM_SIGNING_FINGERPRINT is required}"
: "${RPM_SIGNING_PASSPHRASE:?RPM_SIGNING_PASSPHRASE is required}"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
export GNUPGHOME="$work/gnupg"
mkdir -m 700 "$GNUPGHOME"

fingerprint=$(printf '%s' "$RPM_SIGNING_FINGERPRINT" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
printf '%s' "$RPM_SIGNING_KEY" | gpg --batch --no-tty --import
gpg --batch --no-tty --with-colons --list-secret-keys "$fingerprint" |
	awk -F: -v fingerprint="$fingerprint" '
		$1 == "fpr" && toupper($10) == fingerprint { found = 1 }
		END { exit !found }
	'
gpg --batch --no-tty --armor --export "$fingerprint" >"$work/public.asc"
rpmkeys --import "$work/public.asc"
printf '%s' "$RPM_SIGNING_PASSPHRASE" >"$work/passphrase"
unset RPM_SIGNING_KEY RPM_SIGNING_PASSPHRASE

for package do
	rpmsign --addsign \
	    --define "_gpg_name $fingerprint" \
	    --define "_gpg_sign_cmd_extra_args --batch --pinentry-mode loopback --passphrase-file $work/passphrase" \
	    "$package"
	rpmkeys --checksig "$package" | grep -q 'digests signatures OK$'
done
